      <path d="m282 174 55-59 18 18-54 59" fill="#d7e0e8" stroke="#57728c" stroke-width="1.5"/>
      <circle cx="288" cy="176" r="19" fill="#e9eef2" stroke="#57728c" stroke-width="1.5"/>
      <circle cx="288" cy="176" r="9" fill="#7893ac" stroke="#45627d"/>
      <circle cx="346" cy="125" r="14" fill="#e9eef2" stroke="#57728c" stroke-width="1.5"/>
      <circle cx="346" cy="125" r="5" fill="#7893ac"/>
