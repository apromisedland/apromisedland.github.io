---
import Icon from './Icon.astro';
---
<div class="research-scene">
  <div class="scene-topline"><span><i></i> A FIELD OF POSSIBILITIES</span><span>FIG. 01</span></div>
  <svg class="scene-illustration" viewBox="0 0 540 410" role="img" aria-labelledby="scene-title scene-desc">
    <title id="scene-title">From observation to intelligent action</title>
    <desc id="scene-desc">A conceptual illustration of a robotic arm, an abstract world model, and a reasoning path connecting perception to action.</desc>
    <defs>
      <pattern id="scene-dots" width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".8" fill="#bfc9d3"/></pattern>
      <linearGradient id="plane-fill" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#e7ebee"/><stop offset="1" stop-color="#f4f5f4"/></linearGradient>
      <linearGradient id="arm-fill" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#fcfcf8"/><stop offset="1" stop-color="#cbd5df"/></linearGradient>
      <filter id="scene-shadow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="8"/></filter>
    </defs>
    <rect width="540" height="410" fill="url(#scene-dots)" opacity=".45"/>
    <ellipse cx="277" cy="328" rx="152" ry="30" fill="#92a2b3" opacity=".16" filter="url(#scene-shadow)"/>
    <path d="m59 264 217-117 213 116-215 124Z" fill="url(#plane-fill)" stroke="#b4c0cc"/>
